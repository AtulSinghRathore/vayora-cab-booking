{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vayora-cab-booking",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
